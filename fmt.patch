+// FMT_USE_LOCALE == 0 means "no <locale>", which base.h's locale_ref already honours. chrono.h did
+// not: it names std::locale in the signatures below and in get_locale's union, and those are
+// non-dependent, so the header fails when *parsed*. That makes fmt/chrono.h - and fmt/std.h, which
+// includes it - unusable on a standard library built without localization.
+//
+// At FMT_USE_LOCALE == 1 the alias is upstream verbatim. At 0, locale-dependent output (%a %b %c %x
+// %X %Z, which need std::time_put) static_asserts if instantiated; duration formatting and all
+// format-spec parsing keep working.
+#if FMT_USE_LOCALE
+using locale_type = std::locale;
+#else
+struct locale_type {
+  static auto classic() -> const locale_type& {
+    static const locale_type instance{};
+    return instance;
+  }
+};
+inline auto operator==(const locale_type&, const locale_type&) -> bool { return true; }
+inline auto operator!=(const locale_type&, const locale_type&) -> bool { return false; }
+#endif
+
+inline auto get_classic_locale() -> const locale_type& {
+  static const auto& locale = locale_type::classic();
   return locale;
 }
 
