# libFuzzer dictionary for fuzz_parser (and fuzz_descriptor).
#
# Three groups:
#   1. Frame structure - markers, the ids of fuzz_parser.cpp's catalog, the inline id, whole
#      minimal messages.
#   2. Descriptors (src/remote_fmt/descriptor.hpp) - the tags and whole descriptors of every kind, for an inline
#      string's descriptor part (after 0x1e) and for fuzz_descriptor.
#   3. Format specs - harvested from the "Recommended dictionary" block of a 6-worker
#      300s run (tokens ranked by libFuzzer's own use count), plus a few hand-added
#      specs that steer fmt into its bigint / dragonbox slow paths.
#
# A frame: start (0x57 checked: a CRC-8 before the end; 0x58 unchecked) | id (2 bytes, little endian; 0xFFFF:
# a LEB128 length and the described string follow) | the values as the string's descriptors say | [CRC] | 0xAA.

#=== 1. frame structure ===
checked_start="\x57"
unchecked_start="\x58"
end_marker="\xaa"
inline_id="\xff\xff"
frame_id0="\x57\x00\x00"
frame_id3="\x57\x03\x00"
frame_id8="\x57\x08\x00"
frame_site1="\x57\x01\x80"
frame_site2="\x57\x02\x80"
frame_inline="\x57\xff\xff"
frame_inline_unchecked="\x58\xff\xff"
separator="\x1e"
# "Test {}" with 42 (id 0, i4 zigzag 84), unchecked: start, id, value, end
msg_test_42="\x58\x00\x00\x54\xaa"
# an inline "{}" + u4 with 5, unchecked
msg_inline_u4="\x58\xff\xff\x05{}\x1eu4\x05\xaa"

#=== 2. descriptors ===
d_b="b"
d_c="c"
d_u1="u1"
d_u2="u2"
d_u4="u4"
d_u8="u8"
d_i1="i1"
d_i4="i4"
d_i8="i8"
d_f4="f4"
d_f8="f8"
d_p4="p4"
d_s="s"
d_k="k3:abc"
d_duration="d1/1000000i8"
d_duration_f="d1/1f8"
d_optional="Ou4"
d_expected="Xvi4"
d_variant="V2:u4f4"
d_list="Lu1"
d_set="Su2"
d_map="M(su4)"
d_array="Ai2"
d_tuple="(u1i2)"
d_quantity="Q2: Vf4"
d_styled="Ys"
d_sub="F5:<{}>1:u4"
d_enum="Ei42:0,3:red1,4:blue"
d_bitflag="Gu12:1,1:a2,1:b"
d_register="Ru49:a={} b={}0:2:3,1:1,1:x12,0:"
d_flags="ru42:1,1:a2,1:b"
d_self="*"
d_type="#00000000000000aa"

#=== 3. format specs ===
# Harvested from the fuzzer's own recommended dictionary, highest use count first.
# Chrono specs dominate: they are the deepest reachable code in fmt from here.
spec_open="{:"
spec_empty="{}"
spec_Q="{:%Q}"
spec_Qq="{:%Q%q}"
spec_q="{:%q}"
spec_n="{:%n}"
spec_H="{:%H}"
spec_RzQ="{:%RzQ}"
spec_j="{:%j}"
spec_dot="{:%.}"
spec_b="{:%b}"
spec_I="{:%I}"
spec_S="{:%S}"
spec_SzQ="{:%SzQ}"
spec_R="{:%R}"
spec_G="{:%G}"
spec_Qtick="{:%Q'q}"
spec_26="{:26}"
spec_20="{:20}"
spec_nested_q="{:{:%q}"
spec_U="{:%U}"
spec_Xpct="{:X%}"
spec_c="{:%c}"
spec_A="{:%A}"
spec_dotzU="{:%.zU}"
spec_TzQ="{:%TzQ}"
spec_X="{:%X}"
spec_M="{:%M}"
spec_commazQ="{:%,zQ}"
spec_C="{:%C}"
spec_dot02="{.02}"
spec_nested0="{:{0:%}"
spec_ztm="{z%t%m}"
spec_GQq="{G%Q%q}"
spec_nested0b="{:{0}"
spec_pctpct="{:%%}"
spec_dot2="{:.2}"
spec_bangj="{:!j}"
spec_p="{:%p}"
spec_ZU="{:ZU}"
spec_O="{:%O}"
spec_nested_gt="{:{>%q}"
spec_tq="{:%t%q}"
spec_nested_pct="{:{%}"
spec_d="{:%d}"
spec_nested_z="{:{z:%}"
spec_zpct="{:z%}"
spec_zQ="{:zQ}"
spec_minusqn="{:%-qn}"
spec_Qdollarq="{:%Q$q}"
spec_gtr="{:%>r_}"
spec_MzQ="{:%MzQ}"
spec_5W="{:5W}"
spec_Rqz="{:%Rqz}"
spec_star2="{*.2}"
spec_Tp="{:%T%p}"
spec_Er="{E{:%r}"
spec_pctzSQ="{%z:SQ}"
spec_Rn="{:%R%n}"
spec_nested_us="{:{_%Q}"
spec_QzQ="{:%QzQ}"
spec_zpctq="{:z%%q}"

# One-character openers the fuzzer found productive - cheap and they seed longer specs.
spec_o_pct="{%"
spec_o_z="{z"
spec_o_sp="{ "
spec_o_eq="{="
spec_o_tilde="{~"
spec_o_gt="{>"
spec_o_lt="{<"
spec_o_hash="{#"
spec_o_star="{*"
spec_o_dot="{."
spec_o_semi="{;"
spec_o_comma="{,"
spec_o_plus="{+"
spec_o_lbrack="{["
spec_o_lparen="{("
spec_o_rparen="{)"
spec_o_q="{?"

# Hand-added: not yet reached by fuzzing, but these are the specs that push fmt into
# its bigint and dragonbox paths, where all three committed corpus_regressions live.
spec_prec1000="{:.1000f}"
spec_prec400="{:.400f}"
# Numbers in a replacement field are capped at Max_replacement_field_number (4096) because the
# parser hands width and precision straight to fmt, which allocates the padding eagerly - a
# 27-byte message carrying "{:2147483647}" used to make the host allocate 2 GiB in one malloc.
# These sit just under, at, and just over the cap so both the accepted and the rejected side of
# the bound stay exercised.
spec_width_under="{:4000}"
spec_width_at="{:4096}"
spec_width_over="{:4097}"
spec_hexfloat="{:a}"
spec_expo="{:e}"
spec_general="{:g}"
spec_fixed_neg="{:-.350f}"
spec_hash_x="{:#x}"
spec_hash_b="{:#b}"
spec_hash_o="{:#o}"
spec_04x="{:04x}"
spec_plus_d="{:+d}"
spec_center7="{:*^7}"
spec_range_nested="{::>4}"
spec_range_hex="{::#x}"
spec_dyn_width="{:{}}"
spec_dyn_prec="{:.{}}"
spec_localized="{:L}"
spec_escape="{:?}"
